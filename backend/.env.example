# CarbonTensor backend: copy to .env and replace placeholders. Load with:
# uv run --env-file .env manage.py check
# Django does not automatically load .env files.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Keep existing PostgreSQL database and role names when updating product branding.
DB_NAME=tensorcarbon
DB_USER=tensorcarbon
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# PostgreSQL/PostGIS and native GDAL/GEOS must be installed separately.
# On Windows, add the installed GIS bin directory to PATH if required.
# Optional overrides for native GIS library discovery:
# GDAL_LIBRARY_PATH=C:/path/to/gdal.dll
# GEOS_LIBRARY_PATH=C:/path/to/geos_c.dll
