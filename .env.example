# Copy this file to .env for local overrides. Never commit the resulting .env.

# Host port mappings
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Django development settings
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL/PostGIS credentials
DB_NAME=tensorcarbon
DB_USER=tensorcarbon
DB_PASSWORD=replace-with-a-local-database-password

# Frontend API routing
# Browser requests stay same-origin and are proxied by Next.js.
NEXT_PUBLIC_API_URL=/api/v1
# Server-side Next.js requests use Docker's internal DNS.
INTERNAL_API_URL=http://backend:8000/api/v1
BACKEND_URL=http://backend:8000
# The current frontend is mock-safe by default. Set false to force live API calls.
NEXT_PUBLIC_USE_MOCK_API=true

# Keep the Next.js development server within the Docker Desktop memory budget.
NODE_OPTIONS=--max-old-space-size=1024
